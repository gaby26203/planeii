# Copiá este archivo a .env y completalo. Nunca commitees .env.
# En Cloudflare Workers, las variables sin VITE_ se cargan como vars/secrets
# (`wrangler secret put NOMBRE`); las VITE_* se inyectan en el build.

# ── Supabase ────────────────────────────────────────────────────────────────
# Panel de Supabase → Project Settings → API.
# Públicas (viajan al navegador):
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Las mismas, leídas por el servidor (SSR, server functions, rutas /api):
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secreta. Salta RLS: solo servidor (formulario público, imágenes, invitaciones, admin).
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# ── Sitio ───────────────────────────────────────────────────────────────────
# URL pública sin barra final. Se usa para og:image de las landings con rutas relativas.
VITE_PUBLIC_SITE_URL=http://localhost:8080

# ── Correo (Resend) ─────────────────────────────────────────────────────────
# Sin RESEND_API_KEY los correos se registran en consola y no se envían.
RESEND_API_KEY=
# Remitente con dominio verificado en Resend. En Lovable era noreply@chamaviaja.com.
EMAIL_FROM="PLANEI OS <noreply@chamaviaja.com>"
EMAIL_REPLY_TO=

# ── IA para textos de venta (API compatible con OpenAI Responses) ───────────
# Sin AI_API_KEY y AI_MODEL el botón de IA responde "La IA no está configurada todavía."
AI_API_KEY=
# Vacío = https://api.openai.com/v1
AI_BASE_URL=
# Lovable usaba "openai/gpt-6-astra" a través de su gateway; en OpenAI directo sería "gpt-6-astra".
AI_MODEL=

# ── Tests e2e (Playwright) ──────────────────────────────────────────────────
PLAYWRIGHT_BASE_URL=http://localhost:8080
E2E_TRIP_ID=
E2E_EMAIL=
E2E_PASSWORD=
# Alternativa al login: clave de localStorage de Supabase y JSON de la sesión.
E2E_SUPABASE_STORAGE_KEY=
E2E_SUPABASE_SESSION_JSON=
